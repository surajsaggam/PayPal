{
  "name": "payops-ai-paypal-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "PayOps AI (PayPal Sentinel) — Autonomous Agentic CFO, Smart Invoicing, & Dispute-Defense Control Plane (PS-01)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @payops/api --filter @payops/web run dev",
    "dev:api": "pnpm --filter @payops/api run dev",
    "dev:web": "pnpm --filter @payops/web run dev",
    "build": "pnpm --filter @payops/shared run build && pnpm --filter @payops/api run build && pnpm --filter @payops/web run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run tests/e2e/checkout-dispute.spec.ts",
    "test:ci": "vitest run tests/e2e/checkout-dispute.spec.ts",
    "eval:ci": "pnpm --filter @payops/api run eval:ci",
    "db:migrate": "pnpm --filter @payops/api run db:migrate",
    "db:seed": "tsx scripts/seed-sandbox.ts",
    "seed:sandbox": "tsx scripts/seed-sandbox.ts",
    "verify:deliverables": "python tests/verify_deliverables.py"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
