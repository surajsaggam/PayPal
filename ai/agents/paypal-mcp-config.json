  "mcpServer": {
    "command": "npx",
    "args": ["-y", "@paypal/mcp", "--tools=all"],
    "remoteEndpoint": "https://mcp.paypal.com",
    "sandboxBaseUrl": "https://api-m.sandbox.paypal.com",
