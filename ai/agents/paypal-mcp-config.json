    "M-02": { "role": "Fast Intent Router & Policy Pre-Classifier", "model": "gpt-4o-mini-2024-07-18", "fallback": "claude-3-5-haiku-20241022" },
    "M-03": { "role": "Dispute Evidence & Invoice Document Extractor", "model": "gemini-1.5-pro-002", "fallback": "gpt-4o-2024-08-06" },
