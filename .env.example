# ==============================================================================
# PayOps AI (PayPal Sentinel) — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. Never commit real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
NEXT_PUBLIC_APP_NAME="PayOps AI (PayPal Sentinel)"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 2. PayPal Developer Sandbox & MCP Server Credentials (F-01, F-03, F-04, F-05)
# Obtain free Sandbox credentials at: https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_WEBHOOK_ID="WH-2WR32451HC0233532-67976317FL4543714"
PAYPAL_PARTNER_ATTRIBUTION_ID="PayOpsAI_Hackathon_PPCP"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"

# ------------------------------------------------------------------------------
# 3. Primary Database (PostgreSQL 16 + pgvector) & JunoDB/Redis Store (F-06)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://payops_admin:payops_local_dev_pw@localhost:5432/payops_dev?schema=public"
REDIS_URL="redis://localhost:6379/0"
JUNODB_IDEMPOTENCY_TTL_SECONDS="86400"

# ------------------------------------------------------------------------------
# 4. AI/ML Models & Envoy-Patterned LLM Gateway (M-01 to M-05)
# ------------------------------------------------------------------------------
# M-01 Primary Orchestrator (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="sk-ant-api03-example-key-for-local-config"
M01_PRIMARY_MODEL="claude-3-5-sonnet-20241022"

# M-02 Fast Intent Router (GPT-4o-mini) & M-05 Embeddings (text-embedding-3-small)
OPENAI_API_KEY="sk-proj-example-key-for-local-config"
M02_ROUTER_MODEL="gpt-4o-mini-2024-07-18"
M05_EMBEDDING_MODEL="text-embedding-3-small"

# M-03 Multimodal Dispute Evidence & Invoice Extractor (Gemini 1.5 Pro)
GEMINI_API_KEY="AIzaSyExampleGeminiKeyForLocalConfig"
M03_VISION_MODEL="gemini-1.5-pro-002"

# M-04 Local ONNX Runtime GraphSAGE + LightGBM Friendly-Fraud Scorer
M04_ONNX_MODEL_PATH="./ai/models/payops-graphsage-lgbm-v1.2.onnx"

# ------------------------------------------------------------------------------
# 5. Deterministic Cosmos.AI Policy Firewall Defaults (F-02, E-05)
# ------------------------------------------------------------------------------
DEFAULT_AUTONOMY_LEVEL="L3"
POLICY_MAX_SINGLE_AUTO_REFUND_USD="250.00"
POLICY_MAX_DAILY_REFUND_VELOCITY_USD="500.00"
POLICY_MAX_SINGLE_AUTO_INVOICE_USD="5000.00"
POLICY_MAX_GNN_RISK_SCORE_AUTO="0.35"

# ------------------------------------------------------------------------------
# 6. Ecosystem Sponsor Integrations (AG Grid, Bryntum, APIMatic, Elastic, PYUSD)
# ------------------------------------------------------------------------------
ELASTIC_CLOUD_ID="payops-sentinel-cluster:dXMtY2VudHJhbDEuZ2NwLmNsb3VkLmVzLmlv"
ELASTIC_API_KEY="your_elastic_cloud_api_key_here"
ELASTIC_AUDIT_INDEX="payops-immutable-audit-180d"
APIMATIC_CONTEXT_VALIDATION_MODE="strict"
SOLANA_RPC_URL="https://api.devnet.solana.com"
PYUSD_SOLANA_MINT_ADDRESS="2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo"

# ------------------------------------------------------------------------------
# 7. Security, WebAuthn Passkeys & Demo-Day Resilience (ADR-0005, R-06)
# ------------------------------------------------------------------------------
JWT_ED25519_PRIVATE_KEY_BASE64="LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCg=="
KMS_WORKSPACE_MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:3000"
FF_DEMO_OFFLINE_REPLAY_FALLBACK="auto"

# ------------------------------------------------------------------------------
# 8. 2-Member Parallel Development & Frontend Mock/Live/Replay Switch
# Dev 2 Zone (apps/web): Use NEXT_PUBLIC_API_MODE="mock" (H03-H08) or "live" (H08-H48) or "replay" (R-06)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE="mock"
CHANNEL3_API_KEY="sandbox_channel3_demo_key"
ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/demo/payops-sentinel"

