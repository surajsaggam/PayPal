{
  "name": "@payops/api",
  "version": "1.0.0",
  "private": true,
  "description": "PayOps AI (PayPal Sentinel) — Fastify + @paypal/agent-toolkit + PayPal MCP Server + Cosmos.AI Policy Firewall + JunoDB Idempotent Ledger Backend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/workers/policy-webhook-worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:deploy": "node dist/db/migrate.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "eval:ci": "tsx src/ai/evals/run-ci-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.3",
    "@ai-sdk/google": "^1.0.4",
    "@ai-sdk/openai": "^1.0.5",
    "@elastic/elasticsearch": "^8.15.1",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@payops/shared": "workspace:*",
    "@paypal/agent-toolkit": "^0.4.0",
    "@paypal/paypal-server-sdk": "^0.6.1",
    "@simplewebauthn/server": "^11.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "ai": "^4.0.7",
    "bullmq": "^5.25.2",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "ioredis": "^5.4.1",
    "onnxruntime-node": "^1.20.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
